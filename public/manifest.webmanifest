{
  "name": "MyTinyTools",
  "short_name": "MyTinyTools",
  "description": "Simple free tools: video downloader, QR codes, and PDF to Word",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "background_color": "#0a0a0a",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/grab",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display_override": [
    "fullscreen",
    "standalone"
  ]
}